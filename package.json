{
  "name": "school-transportation-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "cd frontend && npm run dev",
    "dev:api": "cd backend && tsx watch server/index.ts",
    "build": "cd frontend && npm run build",
    "start": "concurrently \"npm run start:api\" \"npm run start:web\"",
    "start:web": "cd frontend && npm run start",
    "start:api": "cd backend && tsx server/index.ts",
    "db:generate": "cd backend && prisma generate --schema prisma/schema.prisma",
    "db:migrate": "cd backend && prisma migrate dev --schema prisma/schema.prisma",
    "db:push": "cd backend && prisma db push --schema prisma/schema.prisma",
    "db:seed": "cd backend && tsx prisma/seed.ts",
    "lint": "eslint frontend backend",
    "typecheck:frontend": "tsc --noEmit -p frontend/tsconfig.json",
    "typecheck:backend": "cd backend && tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "6.19.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
